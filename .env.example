# Telegram userbot credentials from https://my.telegram.org
TG_API_ID=replace_me
TG_API_HASH=replace_me
TG_SESSION=replace_me

# Existing BotFather bot (required by the combined Web Service)
BOT_TOKEN=replace_me

# Gemini API (OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=replace_me
LLM_MODEL=gemini-2.5-flash

# SQLite database
DATABASE_PATH=messages.db
MAX_MESSAGES_PER_ANALYSIS=100

# Automatic background history sync (runs silently, no commands needed)
AUTO_SYNC_DIALOGS=150            # how many most recent chats to sync
AUTO_SYNC_MESSAGES_PER_CHAT=2000 # first-time backfill depth per chat
AUTO_SYNC_INTERVAL_MIN=30        # how often to look for missed messages

# Panel (Telegram Web App). Must be a public HTTPS URL ending in /panel.
# On Render RENDER_EXTERNAL_URL is used automatically if PANEL_URL is empty.
PANEL_URL=
# Optional: extra Telegram user IDs allowed to open the panel (comma separated).
PANEL_ALLOWED_USER_IDS=
